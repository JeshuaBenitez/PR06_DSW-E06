# Ejecución local del backend P05 (no versionar el archivo .env real).
DB_URL=jdbc:postgresql://localhost:5432/pr06_p05_local
DB_USER=
DB_PASSWORD=
API_BASIC_USER=
API_BASIC_PASSWORD=
SERVER_PORT=8080

# Referencia histórica para P02/P03 cuando se utiliza Tomcat local.
TOMCAT_HOME=/ruta/a/tomcat9

# Docker Compose P05. Complete las contraseñas sólo en .env local.
PR06_DOCKER_DB_NAME=pr06_p05_docker
PR06_DOCKER_DB_USER=pr06_app
PR06_DOCKER_DB_PASSWORD=
PR06_DOCKER_BASIC_USER=pr06_local_user
PR06_DOCKER_BASIC_PASSWORD=

# Puertos publicados en el host; cámbielos si existe un conflicto.
PR06_FRONTEND_PORT=4200
PR06_BACKEND_PORT=8080
PR06_DB_PORT=5433
