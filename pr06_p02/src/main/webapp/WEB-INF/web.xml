<?xml version="1.0" encoding="UTF-8"?>

<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="
         http://xmlns.jcp.org/xml/ns/javaee
         http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <display-name>PR06 - Control de asistencia</display-name>

    <servlet>
        <servlet-name>HealthServlet</servlet-name>
        <servlet-class>
            com.pr06.asistencia.servlet.HealthServlet
        </servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>HealthServlet</servlet-name>
        <url-pattern>/health</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>SesionServlet</servlet-name>
        <servlet-class>
            com.pr06.asistencia.servlet.SesionServlet
        </servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>SesionServlet</servlet-name>
        <url-pattern>/sesiones</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>RegistroServlet</servlet-name>
        <servlet-class>
            com.pr06.asistencia.servlet.RegistroServlet
        </servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>RegistroServlet</servlet-name>
        <url-pattern>/registro</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>RegistrosServlet</servlet-name>
        <servlet-class>
            com.pr06.asistencia.servlet.RegistrosServlet
        </servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>RegistrosServlet</servlet-name>
        <url-pattern>/registros</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>FacesServlet</servlet-name>
        <servlet-class>javax.faces.webapp.FacesServlet</servlet-class>
        <load-on-startup>1</load-on-startup>
    </servlet>
    <servlet-mapping>
        <servlet-name>FacesServlet</servlet-name>
        <url-pattern>*.xhtml</url-pattern>
    </servlet-mapping>

    <welcome-file-list>
        <welcome-file>index.xhtml</welcome-file>
    </welcome-file-list>

</web-app>
